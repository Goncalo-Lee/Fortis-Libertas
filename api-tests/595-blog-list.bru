meta {
  name: Bank account log - list
  type: http
  seq: 595
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{logBank}}/activity-logs?sort=created_at&per_page=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("events in order", function () {
    expect(res.body.data.map((x) => `${x.entity_type}.${x.action}`)).to.deep.equal([
      "bank_account.created", "bank_account.updated", "bank_account.frozen", "bank_account.unfrozen",
      "card.created", "card.updated", "card.frozen",
    ]);
  });
  test("no card data anywhere in the log", function () {
    const text = JSON.stringify(res.body.data);
    ["4539578763621486", "2030-12-31", "Log Card"].forEach((secret) => expect(text).to.not.include(secret));
  });
  test("card update lists only the field name", function () {
    expect(res.body.data.find((x) => x.entity_type === "card" && x.action === "updated").metadata).to.deep.equal({ fields: ["cvv"] });
  });
  test("scope and no device data", function () {
    res.body.data.forEach((x) => {
      expect(x.scope).to.equal("bank_account");
      expect(x).to.not.have.property("ip_address");
    });
  });
}
