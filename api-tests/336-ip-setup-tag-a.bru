meta {
  name: Installment plans - setup tag a
  type: http
  seq: 336
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "tech" }
}

script:post-response {
  if (res.status === 201) bru.setVar("ipTagA", res.body.data.tag_id);
}

assert {
  res.status: eq 201
}
