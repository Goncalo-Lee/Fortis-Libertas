meta {
  name: Balances - expense settled
  type: http
  seq: 475
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/financial-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"record_type_id": "{{fbRtExp}}", "category_id": "{{fbCat}}", "payment_method_id": "{{fbPm}}", "name": "Rent", "price": "250.50", "payment_date": "2026-10-12T18:20:00.000Z", "status": "settled"}
}

assert {
  res.status: eq 201
}
