meta {
  name: Installment plans - list q
  type: http
  seq: 356
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/installment-plans?q=lap
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("one", function () { expect(res.body.data.length).to.equal(1); });
}
