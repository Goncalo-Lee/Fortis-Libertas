meta {
  name: Categories - patch color already used
  type: http
  seq: 188
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{linkedId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "color_id": "{{color1}}" }
}

assert {
  res.status: eq 409
  res.body.code: eq COLOR_IN_USE
}
