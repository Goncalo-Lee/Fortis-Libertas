meta {
  name: Financial records - setup card
  type: http
  seq: 390
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{frBaId}}/cards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"cardholder_name": "FR Card", "type_card": "debit", "card_number": "4539578763621486"}
}

script:post-response {
  if (res.status === 201) bru.setVar("frCardId", res.body.data.card_id);
}

assert {
  res.status: eq 201
}
