meta {
  name: Bank accounts - list frozen=true is empty
  type: http
  seq: 207
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts?frozen=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("none frozen", function () { expect(res.body.data.length).to.equal(0); });
}
