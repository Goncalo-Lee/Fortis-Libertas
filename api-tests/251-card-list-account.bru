meta {
  name: Cards - list account cards
  type: http
  seq: 251
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{cardBaId}}/cards
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("two", function () { expect(res.body.data.length).to.equal(2); expect(res.body.meta.total).to.equal(2); });
}
