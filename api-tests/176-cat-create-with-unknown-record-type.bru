meta {
  name: Categories - create with unknown record type
  type: http
  seq: 176
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Unknown", "color_id": "{{color7}}", "icon_id": "{{icon1}}", "record_type_ids": ["00000000-0000-7000-8000-000000000001"] }
}

assert {
  res.status: eq 422
}
