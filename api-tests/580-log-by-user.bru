meta {
  name: Activity logs - filter by user
  type: http
  seq: 580
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/activity-logs?user_id={{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("only that user", function () {
    res.body.data.forEach((x) => expect(x.user.user_id).to.equal(bru.getVar("userId")));
  });
}
