meta {
  name: Bank account log - member event
  type: http
  seq: 598
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{logBank}}/activity-logs?entity_type=member
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data[0].action: eq member_added
  res.body.data[0].entity_id: eq {{userId2}}
}
