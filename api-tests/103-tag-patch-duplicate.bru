meta {
  name: Tags - rename to existing name
  type: http
  seq: 103
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{tagDashboardId}}/tags/{{essentialTagId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Holiday" }
}

assert {
  res.status: eq 409
  res.body.code: eq NAME_ALREADY_EXISTS
}
