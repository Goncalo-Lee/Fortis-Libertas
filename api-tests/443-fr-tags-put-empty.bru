meta {
  name: Financial records - clear tags
  type: http
  seq: 443
}

put {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records/{{frId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"tag_ids": []}
}

assert {
  res.status: eq 200
  res.body.data.tags.length: eq 0
}
