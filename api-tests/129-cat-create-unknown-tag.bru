meta {
  name: Categories - unknown tag id
  type: http
  seq: 129
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Other", "tag_ids": ["00000000-0000-7000-8000-000000000001"], "color_id": "{{color4}}", "icon_id": "{{icon1}}", "record_type_ids": ["{{catRtExpenses}}"] }
}

assert {
  res.status: eq 422
}
