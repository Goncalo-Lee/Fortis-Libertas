meta {
  name: Transactions - deleted=false hides it
  type: http
  seq: 564
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/transactions?deleted=false&per_page=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("not listed", function () {
    expect(res.body.data.find((t) => t.source_id === bru.getVar("histRec"))).to.equal(undefined);
  });
}
