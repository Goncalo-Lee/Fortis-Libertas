meta {
  name: Payment methods - list q
  type: http
  seq: 306
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{pmDashId}}/payment-methods?q=vis
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("one", function () { expect(res.body.data.length).to.equal(1); });
}
