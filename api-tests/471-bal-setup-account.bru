meta {
  name: Balances - setup bank account
  type: http
  seq: 471
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"name": "Balance account", "initial_balance": "100.00"}
}

script:post-response {
  if (res.status === 201) bru.setVar("fbBa", res.body.data.bank_account_id);
}

assert {
  res.status: eq 201
  res.body.data.balance: matches ^100\.00$
}
