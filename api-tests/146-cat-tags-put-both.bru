meta {
  name: Category tags - replace with both
  type: http
  seq: 146
}

put {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "tag_ids": ["{{catTagA}}", "{{catTagB}}"] }
}

assert {
  res.status: eq 200
  res.body.data.length: eq 2
}
