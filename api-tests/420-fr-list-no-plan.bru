meta {
  name: Financial records - filter no plan
  type: http
  seq: 420
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records?installment_plan_id=none
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 4
}
