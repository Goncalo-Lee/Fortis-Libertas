meta {
  name: Tags - viewer cannot create
  type: http
  seq: 109
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{tagDashboardId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token2}}
}

body:json {
  { "name": "ByViewer" }
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}
