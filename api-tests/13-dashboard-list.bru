meta {
  name: Dashboard - list
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/dashboards
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("list contains the new dashboard with meta", function () {
    const ids = res.body.data.map((d) => d.dashboard_id);
    expect(ids).to.include(bru.getVar("dashboardId"));
    expect(res.body.meta.page).to.equal(1);
  });
}
