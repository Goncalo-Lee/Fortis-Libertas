meta {
  name: Activity logs - dashboard log
  type: http
  seq: 574
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/activity-logs?per_page=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: gte 1
}

tests {
  test("newest first", function () {
    const d = res.body.data.map((x) => x.created_at);
    expect(d).to.deep.equal([...d].sort().reverse());
  });
  test("owner does not see device data", function () {
    expect(res.body.data[0]).to.not.have.property("ip_address");
    expect(res.body.data[0]).to.not.have.property("user_agent");
  });
  test("shape", function () {
    const x = res.body.data[0];
    expect(x.scope).to.equal("dashboard");
    expect(x.user).to.have.all.keys("user_id", "user_name", "full_name", "image");
  });
}
