meta {
  name: Payment methods - list mine as editor is empty
  type: http
  seq: 308
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{pmDashId}}/payment-methods?mine=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token2}}
}

assert {
  res.status: eq 200
}

tests {
  test("none", function () { expect(res.body.data.length).to.equal(0); });
}
