meta {
  name: Tags - create second
  type: http
  seq: 94
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{tagDashboardId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Holiday" }
}

script:post-response {
  if (res.status === 201) bru.setVar("holidayTagId", res.body.data.tag_id);
}

assert {
  res.status: eq 201
  res.body.data.description: isNull
}
