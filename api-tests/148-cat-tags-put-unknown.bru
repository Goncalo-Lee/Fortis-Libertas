meta {
  name: Category tags - unknown tag
  type: http
  seq: 148
}

put {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "tag_ids": ["00000000-0000-7000-8000-000000000001"] }
}

assert {
  res.status: eq 422
}
