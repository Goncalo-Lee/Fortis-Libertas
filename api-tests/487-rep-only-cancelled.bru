meta {
  name: Reports - only cancelled
  type: http
  seq: 487
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/reports/summary?payment_date_from=2026-10-01T00:00:00.000Z&payment_date_to=2026-10-31T23:59:59.999Z&status=cancelled
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.total: matches ^40\.00$
  res.body.data.groups[0].count: eq 1
}
