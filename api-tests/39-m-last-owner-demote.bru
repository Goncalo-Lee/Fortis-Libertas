meta {
  name: Members - last owner cannot demote
  type: http
  seq: 39
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboardId}}/members/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "role": "viewer" }
}

assert {
  res.status: eq 409
  res.body.code: eq LAST_OWNER
}
