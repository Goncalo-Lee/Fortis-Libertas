meta {
  name: Financial records - setup tag b
  type: http
  seq: 388
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"name": "home"}
}

script:post-response {
  if (res.status === 201) bru.setVar("frTagB", res.body.data.tag_id);
}

assert {
  res.status: eq 201
}
