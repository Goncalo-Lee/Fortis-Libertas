meta {
  name: Categories - search by name
  type: http
  seq: 143
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories?q=trav
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
  res.body.data[0].name: eq Travel
}
