meta {
  name: Record types - same name, new description
  type: http
  seq: 70
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{rtDashboardId}}/record-types/{{savingsTypeId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Savings", "description": "updated" }
}

assert {
  res.status: eq 200
  res.body.data.name: eq Savings
  res.body.data.description: eq updated
}
