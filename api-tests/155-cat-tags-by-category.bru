meta {
  name: Tags - filter by category with include
  type: http
  seq: 155
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/tags?category_id={{foodId}}&include=categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
  res.body.data[0].categories[0].name: eq Food
}
