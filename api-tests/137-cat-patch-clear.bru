meta {
  name: Categories - clear description
  type: http
  seq: 137
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "description": null }
}

assert {
  res.status: eq 200
  res.body.data.description: isNull
}
