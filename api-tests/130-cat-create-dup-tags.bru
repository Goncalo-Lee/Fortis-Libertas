meta {
  name: Categories - repeated tag ids
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Other", "tag_ids": ["{{catTagA}}", "{{catTagA}}"], "color_id": "{{color4}}", "icon_id": "{{icon1}}", "record_type_ids": ["{{catRtExpenses}}"] }
}

assert {
  res.status: eq 422
}
