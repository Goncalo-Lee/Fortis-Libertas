meta {
  name: Balances - setup payment method
  type: http
  seq: 473
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/payment-methods
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"name": "Balance Visa", "card_id": "{{fbCard}}"}
}

script:post-response {
  if (res.status === 201) bru.setVar("fbPm", res.body.data.payment_method_id);
}

assert {
  res.status: eq 201
}
