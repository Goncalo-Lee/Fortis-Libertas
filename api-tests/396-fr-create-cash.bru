meta {
  name: Financial records - create with cash payment method
  type: http
  seq: 396
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"record_type_id": "{{frRt}}", "category_id": "{{frCat}}", "payment_method_id": "{{frPmCash}}", "name": "Coffee", "price": "3", "payment_date": "2026-10-12T18:20:00.000Z", "status": "pending"}
}

script:post-response {
  if (res.status === 201) bru.setVar("frId2", res.body.data.financial_record_id);
}

assert {
  res.status: eq 201
  res.body.data.price: matches ^3\.00$
}
