meta {
  name: Linked accounts - list
  type: http
  seq: 535
}

get {
  url: {{baseUrl}}/api/v1/me/accounts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.length: eq 1
  res.body.data[0].provider_id: eq credential
}

tests {
  test("never returns secrets", function () {
    const acc = res.body.data[0];
    ["password", "access_token", "refresh_token", "id_token"].forEach((k) => expect(acc).to.not.have.property(k));
  });
}
