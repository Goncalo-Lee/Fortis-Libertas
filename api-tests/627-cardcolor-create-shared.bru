meta {
  name: Card color - two cards can share a color
  type: http
  seq: 627
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{ccBaId}}/cards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "cardholder_name": "Same color", "type_card": "credit", "color_id": "{{color3}}" }
}

script:post-response {
  if (res.status === 201) bru.setVar("ccCard3", res.body.data.card_id);
}

assert {
  res.status: eq 201
}
