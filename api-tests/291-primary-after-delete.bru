meta {
  name: Primary account - deleted account reads as null
  type: http
  seq: 291
}

get {
  url: {{baseUrl}}/api/v1/me/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("null", function () { expect(res.body.data.primary_bank_account_id).to.equal(null); });
}
