meta {
  name: Financial records - update category not linked
  type: http
  seq: 437
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records/{{frId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"category_id": "{{frCatIncome}}"}
}

assert {
  res.status: eq 422
}
