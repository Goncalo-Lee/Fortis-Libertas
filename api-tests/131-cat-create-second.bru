meta {
  name: Categories - create second
  type: http
  seq: 131
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Travel", "color_id": "{{color2}}", "icon_id": "{{icon2}}", "record_type_ids": ["{{catRtExpenses}}", "{{catRtInvestment}}"] }
}

script:post-response {
  if (res.status === 201) bru.setVar("travelId", res.body.data.category_id);
}

assert {
  res.status: eq 201
  res.body.data.description: isNull
}
