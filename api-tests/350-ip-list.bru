meta {
  name: Installment plans - list
  type: http
  seq: 350
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/installment-plans
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("two, nearest due first", function () { expect(res.body.meta.total).to.equal(2); expect(res.body.data[0].name).to.equal("Trip"); });
}
