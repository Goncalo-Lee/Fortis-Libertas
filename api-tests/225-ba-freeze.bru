meta {
  name: Bank accounts - freeze
  type: http
  seq: 225
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{baId}}/freeze
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("frozen", function () { expect(res.body.data.frozen_at).to.be.a("string"); });
}
