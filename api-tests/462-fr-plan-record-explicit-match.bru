meta {
  name: Financial records - plan record with matching type and category
  type: http
  seq: 462
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"payment_method_id": "{{frPm}}", "name": "Plan rec", "price": "10", "payment_date": "2026-10-12T18:20:00.000Z", "status": "paid", "installment_plan_id": "{{frPlan}}", "record_type_id": "{{frRt}}", "category_id": "{{frCat}}"}
}

assert {
  res.status: eq 201
}
