meta {
  name: Cards - create bad cvv
  type: http
  seq: 245
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{cardBaId}}/cards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "cardholder_name": "X", "type_card": "debit", "cvv": "12" }
}

assert {
  res.status: eq 422
}
