meta {
  name: Category tags - clear all
  type: http
  seq: 147
}

put {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "tag_ids": [] }
}

assert {
  res.status: eq 200
  res.body.data.length: eq 0
}
