meta {
  name: Bank accounts - get
  type: http
  seq: 209
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{baId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("shape", function () { expect(res.body.data.bank_account_id).to.equal(bru.getVar("baId")); expect(res.body.data.frozen_at).to.equal(null); });
}
