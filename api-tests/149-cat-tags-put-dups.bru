meta {
  name: Category tags - repeated ids
  type: http
  seq: 149
}

put {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "tag_ids": ["{{catTagA}}", "{{catTagA}}"] }
}

assert {
  res.status: eq 422
}
