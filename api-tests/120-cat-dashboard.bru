meta {
  name: Categories - create dashboard
  type: http
  seq: 120
}

post {
  url: {{baseUrl}}/api/v1/dashboards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Categories-Dashboard" }
}

script:post-response {
  if (res.status === 201) bru.setVar("catDashboardId", res.body.data.dashboard_id);
}

assert {
  res.status: eq 201
}
