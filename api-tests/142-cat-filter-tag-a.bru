meta {
  name: Categories - filter by linked tag
  type: http
  seq: 142
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories?tag_id={{catTagA}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
  res.body.data[0].name: eq Food
}
