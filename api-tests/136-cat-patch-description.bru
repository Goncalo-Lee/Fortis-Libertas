meta {
  name: Categories - same name, new description
  type: http
  seq: 136
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Food", "description": "updated" }
}

assert {
  res.status: eq 200
  res.body.data.description: eq updated
}
