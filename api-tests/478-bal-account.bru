meta {
  name: Balances - bank account balance
  type: http
  seq: 478
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{fbBa}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.balance: matches ^849\.50$
  res.body.data.initial_balance: matches ^100\.00$
}
