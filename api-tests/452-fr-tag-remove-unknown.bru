meta {
  name: Financial records - remove unlinked tag is idempotent
  type: http
  seq: 452
}

delete {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records/{{frId}}/tags/00000000-0000-7000-8000-000000000000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}
