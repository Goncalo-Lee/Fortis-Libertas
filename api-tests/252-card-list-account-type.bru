meta {
  name: Cards - list filter type_card
  type: http
  seq: 252
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{cardBaId}}/cards?type_card=credit
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("one", function () { expect(res.body.data.length).to.equal(1); });
}
