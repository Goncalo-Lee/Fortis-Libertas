meta {
  name: Financial records - create unknown tag
  type: http
  seq: 402
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"record_type_id": "{{frRt}}", "category_id": "{{frCat}}", "payment_method_id": "{{frPm}}", "name": "Laptop", "price": "100.50", "payment_date": "2026-10-12T18:20:00.000Z", "status": "paid", "tag_ids": ["00000000-0000-7000-8000-000000000000"]}
}

assert {
  res.status: eq 422
}
