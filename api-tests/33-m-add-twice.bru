meta {
  name: Members - already member
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboardId}}/members
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "email": "{{email2}}", "role": "viewer" }
}

assert {
  res.status: eq 409
  res.body.code: eq ALREADY_MEMBER
}
