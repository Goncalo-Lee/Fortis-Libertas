meta {
  name: Sign up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

body:json {
  {
    "name": "API Test",
    "email": "{{email}}",
    "password": "{{process.env.TEST_PASSWORD}}"
  }
}

script:pre-request {
  // A new user per run, so the test never collides with old data
  bru.setVar("email", `api.${Date.now()}@example.com`);
}

assert {
  res.status: eq 200
}
