meta {
  name: Dashboard - create
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/dashboards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Api-Dashboard" }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("dashboardId", res.body.data.dashboard_id);
  }
}

assert {
  res.status: eq 201
  res.body.data.role: eq owner
  res.body.data.member_count: eq 1
}

tests {
  test("Location header points to the new dashboard", function () {
    expect(res.getHeader("location")).to.equal("/api/v1/dashboards/" + res.body.data.dashboard_id);
  });
}
