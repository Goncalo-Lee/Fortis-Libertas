meta {
  name: Color swap - Expenses back to its color
  type: http
  seq: 620
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{swapDash}}/record-types/{{expensesRt}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.color_id: eq {{expensesColor}}
}
