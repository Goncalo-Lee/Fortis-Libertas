meta {
  name: Installment plans - list sort -total_amount
  type: http
  seq: 357
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/installment-plans?sort=-total_amount
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("Laptop first", function () { expect(res.body.data[0].name).to.equal("Laptop"); });
}
