meta {
  name: Bank account log - create a card
  type: http
  seq: 592
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{logBank}}/cards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "cardholder_name": "Log Card", "type_card": "debit", "card_number": "4539578763621486", "expiry_date": "2030-12-31", "cvv": "987" }
}

script:post-response {
  if (res.status === 201) bru.setVar("logCard", res.body.data.card_id);
}

assert {
  res.status: eq 201
}
