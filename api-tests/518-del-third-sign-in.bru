meta {
  name: Delete me - third user signs in
  type: http
  seq: 518
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

body:json {
  { "email": "{{email3}}", "password": "{{process.env.TEST_PASSWORD}}" }
}

script:post-response {
  bru.setVar("token3", res.getHeader("set-auth-token"));
}

assert {
  res.status: eq 200
}
