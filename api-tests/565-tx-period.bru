meta {
  name: Transactions - occurred period and oldest first
  type: http
  seq: 565
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/transactions?occurred_from=2026-10-01T00:00:00.000Z&occurred_to=2026-10-15T00:00:00.000Z&sort=occurred_at
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("inside the period", function () {
    res.body.data.forEach((t) => {
      expect(t.occurred_at >= "2026-10-01T00:00:00.000Z").to.equal(true);
      expect(t.occurred_at <= "2026-10-15T00:00:00.000Z").to.equal(true);
    });
  });
}
