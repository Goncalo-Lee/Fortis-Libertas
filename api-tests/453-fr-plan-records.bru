meta {
  name: Financial records - plan records
  type: http
  seq: 453
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/installment-plans/{{frPlan}}/financial-records
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
}
