meta {
  name: Tags - deleted name stays reserved
  type: http
  seq: 115
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{tagDashboardId}}/tags
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Holiday" }
}

assert {
  res.status: eq 409
  res.body.code: eq NAME_ALREADY_EXISTS
}
