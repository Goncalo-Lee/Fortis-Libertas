meta {
  name: Installment plans - setup dashboard
  type: http
  seq: 331
}

post {
  url: {{baseUrl}}/api/v1/dashboards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Plans dashboard" }
}

script:post-response {
  if (res.status === 201) bru.setVar("ipDashId", res.body.data.dashboard_id);
}

assert {
  res.status: eq 201
}
