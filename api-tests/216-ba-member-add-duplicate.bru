meta {
  name: Bank accounts - add member twice
  type: http
  seq: 216
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{baId}}/members
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "user_id": "{{userId2}}", "role": "viewer" }
}

assert {
  res.status: eq 409
}
