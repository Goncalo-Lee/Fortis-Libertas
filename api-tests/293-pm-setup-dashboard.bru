meta {
  name: Payment methods - setup dashboard
  type: http
  seq: 293
}

post {
  url: {{baseUrl}}/api/v1/dashboards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "PM dashboard" }
}

script:post-response {
  if (res.status === 201) bru.setVar("pmDashId", res.body.data.dashboard_id);
}

assert {
  res.status: eq 201
}
