meta {
  name: Installment plans - create unknown currency
  type: http
  seq: 347
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/installment-plans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Bad", "category_id": "{{ipCatId}}", "currency": "ZZZ", "total_amount": "10", "total_installments": 1, "due_date": "2027-01-01" }
}

assert {
  res.status: eq 422
}
