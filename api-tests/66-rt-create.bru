meta {
  name: Record types - create
  type: http
  seq: 66
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{rtDashboardId}}/record-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Savings", "description": "first" }
}

script:post-response {
  if (res.status === 201) bru.setVar("savingsTypeId", res.body.data.record_type_id);
}

assert {
  res.status: eq 201
  res.body.data.name: eq Savings
}

tests {
  test("Location header points to the new record type", function () {
    expect(res.getHeader("location")).to.equal(
      "/api/v1/dashboards/" + bru.getVar("rtDashboardId") + "/record-types/" + res.body.data.record_type_id,
    );
  });
}
