meta {
  name: Category tags - list
  type: http
  seq: 144
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories/{{foodId}}/tags
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.length: eq 1
  res.body.data[0].name: eq Essential
}
