meta {
  name: Dashboard - deactivate
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/dashboards/{{dashboardId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "is_active": false }
}

assert {
  res.status: eq 200
  res.body.data.is_active: eq false
}
