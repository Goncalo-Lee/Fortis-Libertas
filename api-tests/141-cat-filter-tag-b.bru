meta {
  name: Categories - filter by tag without links
  type: http
  seq: 141
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories?tag_id={{catTagB}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 0
}
