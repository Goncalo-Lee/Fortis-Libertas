meta {
  name: Installment plans - setup income-only category
  type: http
  seq: 335
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Salary", "color_id": "{{color2}}", "icon_id": "{{icon1}}", "record_type_ids": ["{{ipRtIncome}}"] }
}

script:post-response {
  if (res.status === 201) bru.setVar("ipCatIncomeId", res.body.data.category_id);
}

assert {
  res.status: eq 201
}
