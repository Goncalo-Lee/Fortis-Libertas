meta {
  name: Categories - delete cleans tag links
  type: http
  seq: 169
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/tags?include=categories&q=Essential
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
  res.body.data[0].categories.length: eq 0
}
