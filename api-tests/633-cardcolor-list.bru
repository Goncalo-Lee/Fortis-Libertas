meta {
  name: Card color - list returns color and bank name
  type: http
  seq: 633
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{ccBaId}}/cards
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("every card has color and bank_name", function () {
    res.body.data.forEach(function (c) {
      expect(c.color).to.not.equal(null);
      expect(c.bank_name).to.equal("Color account");
    });
  });
}
