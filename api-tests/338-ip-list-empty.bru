meta {
  name: Installment plans - list empty
  type: http
  seq: 338
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{ipDashId}}/installment-plans
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("empty", function () { expect(res.body.data.length).to.equal(0); });
}
