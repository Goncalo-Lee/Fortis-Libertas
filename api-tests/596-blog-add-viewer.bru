meta {
  name: Bank account log - add the second user as viewer
  type: http
  seq: 596
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts/{{logBank}}/members
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "email": "{{email2}}", "role": "viewer" }
}

assert {
  res.status: eq 201
}
