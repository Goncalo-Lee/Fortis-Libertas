meta {
  name: Financial records - create unknown payment method
  type: http
  seq: 400
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"record_type_id": "{{frRt}}", "category_id": "{{frCat}}", "payment_method_id": "00000000-0000-7000-8000-000000000000", "name": "Laptop", "price": "100.50", "payment_date": "2026-10-12T18:20:00.000Z", "status": "paid"}
}

assert {
  res.status: eq 422
}
