meta {
  name: Record types - editor cannot create
  type: http
  seq: 77
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{rtDashboardId}}/record-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token2}}
}

body:json {
  { "name": "ByEditor" }
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}
