meta {
  name: Categories - color held by a deleted category
  type: http
  seq: 173
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "SameColor", "color_id": "{{color1}}", "icon_id": "{{icon1}}", "record_type_ids": ["{{catRtExpenses}}"] }
}

assert {
  res.status: eq 409
  res.body.code: eq COLOR_IN_USE
}
