meta {
  name: Balances - setup category for both kinds
  type: http
  seq: 470
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"name": "Mixed", "color_id": "{{color1}}", "icon_id": "{{icon1}}", "record_type_ids": ["{{fbRtExp}}", "{{fbRtInc}}"]}
}

script:post-response {
  if (res.status === 201) bru.setVar("fbCat", res.body.data.category_id);
}

assert {
  res.status: eq 201
}
