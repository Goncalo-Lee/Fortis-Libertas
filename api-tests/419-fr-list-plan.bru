meta {
  name: Financial records - filter plan
  type: http
  seq: 419
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records?installment_plan_id={{frPlan}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
}
