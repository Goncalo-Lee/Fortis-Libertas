meta {
  name: Reports - two statuses (comma)
  type: http
  seq: 488
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/reports/summary?payment_date_from=2026-10-01T00:00:00.000Z&payment_date_to=2026-10-31T23:59:59.999Z&status=paid,settled
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.data.total: matches ^1250\.50$
}
