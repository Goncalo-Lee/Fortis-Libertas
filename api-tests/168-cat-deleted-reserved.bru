meta {
  name: Categories - deleted name stays reserved
  type: http
  seq: 168
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Food" }
}

assert {
  res.status: eq 409
  res.body.code: eq NAME_ALREADY_EXISTS
}
