meta {
  name: Record types - search by name
  type: http
  seq: 84
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{rtDashboardId}}/record-types?q=inc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: eq 1
  res.body.data[0].name: eq Income
}
