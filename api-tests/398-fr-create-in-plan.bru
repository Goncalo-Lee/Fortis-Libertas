meta {
  name: Financial records - create in plan
  type: http
  seq: 398
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{frDashId}}/financial-records
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {"record_type_id": "{{frRt}}", "category_id": "{{frCat}}", "payment_method_id": "{{frPm}}", "name": "Instalment 1", "price": "100", "payment_date": "2026-10-12T18:20:00.000Z", "status": "paid", "installment_plan_id": "{{frPlan}}"}
}

script:post-response {
  if (res.status === 201) bru.setVar("frId4", res.body.data.financial_record_id);
}

assert {
  res.status: eq 201
  res.body.data.installment_plan_id: eq {{frPlan}}
}
