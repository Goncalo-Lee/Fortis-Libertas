meta {
  name: Bank accounts - list members
  type: http
  seq: 218
}

get {
  url: {{baseUrl}}/api/v1/bank-accounts/{{baId}}/members
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

tests {
  test("two", function () { expect(res.body.data.length).to.equal(2); });
}
