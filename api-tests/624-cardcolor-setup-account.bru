meta {
  name: Card color - setup bank account
  type: http
  seq: 624
}

post {
  url: {{baseUrl}}/api/v1/bank-accounts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "Color account", "initial_balance": "0" }
}

script:post-response {
  if (res.status === 201) bru.setVar("ccBaId", res.body.data.bank_account_id);
}

assert {
  res.status: eq 201
}
