meta {
  name: Notifications - mark as unread
  type: http
  seq: 545
}

patch {
  url: {{baseUrl}}/api/v1/me/notifications/{{notificationId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token2}}
}

body:json {
  { "read": false }
}

assert {
  res.status: eq 200
  res.body.data.read_at: isNull
}
