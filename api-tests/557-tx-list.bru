meta {
  name: Transactions - list
  type: http
  seq: 557
}

get {
  url: {{baseUrl}}/api/v1/dashboards/{{fbDash}}/transactions?per_page=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.meta.total: gte 4
}

tests {
  test("newest first", function () {
    const d = res.body.data.map((t) => t.occurred_at);
    expect(d).to.deep.equal([...d].sort().reverse());
  });
  test("shape", function () {
    const t = res.body.data[0];
    expect(t.source_type).to.equal("financial_record");
    expect(t.user).to.have.all.keys("user_id", "user_name", "full_name", "image");
    expect(t.record_type).to.have.all.keys("record_type_id", "name", "color", "icon");
    expect(t.amount).to.match(/^\d+\.\d{2}$/);
    expect(t).to.have.property("converted");
  });
}
