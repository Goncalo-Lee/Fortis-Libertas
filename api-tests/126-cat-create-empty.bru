meta {
  name: Categories - empty name
  type: http
  seq: 126
}

post {
  url: {{baseUrl}}/api/v1/dashboards/{{catDashboardId}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "name": "" }
}

assert {
  res.status: eq 422
  res.body.errors[0].pointer: eq /name
}
