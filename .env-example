# ============================================================================
# ENVIRONMENT CONFIGURATION – EXAMPLE (.env-example)
# ============================================================================
# Instructions:
# 1. Copy this file and rename it to .env
# 2. Replace the values below with your environment’s actual credentials
# 3. Never commit the .env file (containing actual data) to version control
# ============================================================================

# -----------------------------------------------------------------------------
# MYSQL DATABASE
# -----------------------------------------------------------------------------
# MySQL root user’s master password
MYSQL_ROOT_PASSWORD=your_secure_password_here

# Name of the database to be created or connected to
MYSQL_DATABASE=test_login

# Default MySQL port
PORT_DATABASE=3306

# Full URL for connecting to the database
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# Example: mysql://root:mypassword@localhost:3306/test_login
DATABASE_URL=mysql://<user>:<password>@<host>:<port>/<database>

# -----------------------------------------------------------------------------
# BETTER AUTH AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key for signing and verifying JWT tokens
# Generate using: openssl rand -base64 32
# IMPORTANT: This secret must be unique and secure in production
BETTER_AUTH_SECRET=generate_a_secret_key_here

# Base URL of your application
# In development: http://localhost:3000
# In production: https://seu-dominio.com
BETTER_AUTH_URL=http://localhost:3000
