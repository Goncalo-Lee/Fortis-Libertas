<?xml version="1.0" encoding="utf-8"?>
<!--
    This is the Android Manifest file. It contains metadata about the application,
    such as required permissions, components, and configuration settings.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Request internet permission for network operations -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FortisApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fortislibertas"
        tools:ignore="MissingClass">
        <!--
            Main activity that serves as the entry point for the application UI.
            android:exported="true" is required for the main activity to be launched.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fortislibertas"
            android:windowSoftInputMode="adjustResize">
            <!-- Intent filter to declare this activity as the main launcher of the app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>